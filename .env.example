# Optional. The app works without this file.
# Copy to .env.local only when you need to override the defaults.
# SQLite belongs on the local machine; never commit its file or backups.
HARKA_DATABASE_PATH=.data/harka.sqlite
NEXT_TELEMETRY_DISABLED=1

# Public deployment behind Coolify (runtime values; leave commented for local dev).
# HARKA_PUBLIC_ORIGIN=https://haraka.seif4d.com
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# HARKA_SETUP_TOKEN=
# Docker uses HARKA_DATABASE_PATH=/app/.data/harka.sqlite with persistent storage.
