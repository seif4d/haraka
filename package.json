{
  "name": "harka-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-product-tests.cjs",
    "repo:check": "node scripts/check-repository.cjs",
    "schedule:import:first-year": "node scripts/import-first-year-schedules.cjs",
    "schedule:import": "node scripts/import-third-year-schedules.cjs",
    "test:container": "node scripts/check-container.cjs",
    "db:backup": "node scripts/backup-database.cjs"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Harka — an Arabic learning platform for Sports Sciences students at Assiut University."
}
